# Supabase — copia este archivo a `.env.local` y rellena tus credenciales.
# Panel: https://supabase.com/dashboard → Project Settings → API Keys
#
# NO subas `.env.local` al repositorio (ya está en .gitignore).

# URL del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública (va al navegador; respeta RLS).
# Puede ser el "anon key" (empieza por eyJ...) o la nueva "publishable key"
# (empieza por sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-publica

# Llave secreta — SOLO SERVIDOR — salta todas las políticas RLS.
# Puede ser el "service_role key" (eyJ...) o la nueva "secret key" (sb_secret_...).
# NUNCA la prefijes con NEXT_PUBLIC_ ni la commitees.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-secreta
